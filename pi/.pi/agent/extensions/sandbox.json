{
  "enabled": true,
  "blockNetwork": false,
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.aws",
      "~/.gnupg"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.cache/go-build",
      "~/go/pkg/mod",
      "~/.cache/cymbal/repos"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  }
}