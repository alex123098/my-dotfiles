{
  "lastChangelogVersion": "0.84.2",
  "defaultProvider": "openrouter",
  "defaultModel": "stealth/ox-alpha",
  "defaultThinkingLevel": "medium",
  "enableInstallTelemetry": false,
  "treeFilterMode": "default",
  "theme": "tokyo-night",
  "extensions": [
    "extensions/status-bar.ts",
    "extensions/git-scout.ts",
    "extensions/sandbox",
    "extensions/cymbal-nudge.ts"
  ],
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-web-access",
    "npm:pi-intercom",
    "npm:pi-prompt-template-model",
    "npm:pi-lsp",
    "npm:pi-vimmode",
    "npm:pi-nvim",
    "npm:@ineersa/my-pi-themes",
    "npm:pi-rtk-optimizer",
    "npm:@pi-vault/pi-dcp",
    "npm:pi-herdr-subagents"
  ],
  "observational-memory": {
    "compactAfterTokens": 125000
  },
  "hideThinkingBlock": false,
  "piVimMode": {
    "startMode": "insert",
    "cursor": {
      "insert": "bar",
      "normal": "block"
    },
    "ui": {
      "status": {
        "items": [
          "mode",
          "pending",
          "search",
          "macro",
          "cursorPosition",
          "warnings"
        ]
      }
    }
  }
}