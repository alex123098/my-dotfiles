{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue-bell": "#9aa5ce",
    "blue-black": "#565f89",
    "celeste-blue": "#b4f9f8",
    "light-sky-blue": "#7dcfff",
    "main-bg": "#24283b",
    "pastal-grey": "#cfc9c2",
    "pistachio-green": "#9ece6a",
    "solid-green": "#35ed3b",
    "t-background": "p:main-bg",
    "terminal-black": "#414868",
    "terminal-blue": "#7aa2f7",
    "terminal-green": "#73daca",
    "terminal-magenta": "#bb9af7",
    "terminal-red": "#f7768e",
    "terminal-white": "#c0caf5",
    "terminal-yellow": "#e0af68",
    "white-blue": "#a9b1d6"
  },
  "secondary_prompt": {
    "template": "❯ ",
    "foreground": "p:terminal-blue",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "❯ ",
    "foreground": "p:terminal-white",
    "background": "transparent"
  },
  "console_title_template": "{{if .Root}} ⚡{{end}} {{.PWD }} @ {{.HostName}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "style": "plain",
          "template": "\uf0e7 ",
          "foreground": "p:terminal-red",
          "background": "",
          "type": "root"
        },
        {
          "style": "plain",
          "template": "{{ .Icon }}  ",
          "foreground": "p:terminal-blue",
          "background": "transparent",
          "type": "os"
        },
        {
          "properties": {
            "folder_icon": "...",
            "max_width": 35,
            "style": "powerlevel"
          },
          "style": "plain",
          "template": "<b>{{ .Path }}</b> ",
          "foreground": "p:terminal-magenta",
          "background": "",
          "type": "path"
        },
        {
          "properties": {
            "branch_icon": "\ue725 ",
            "fetch_status": true
          },
          "style": "plain",
          "template": "({{ .UpstreamIcon }}{{ .HEAD }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }}) ",
          "foreground": "p:light-sky-blue",
          "background": "",
          "type": "git",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:terminal-yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0)}}p:light-sky-blue {{ end }}",
            "{{ if gt .Ahead 0 }}p:terminal-blue{{ end }}",
            "{{ if gt .Behind 0 }}p:celeste-blue{{ end }}"
          ]
        },
        {
          "style": "plain",
          "template": "❯",
          "foreground": "p:terminal-blue",
          "background": "",
          "type": "text"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "style": "plain",
          "template": "\ue718 {{ .Full }} ",
          "foreground": "p:pistachio-green",
          "background": "",
          "type": "node"
        },
        {
          "style": "plain",
          "template": "\ue77f {{ .Full}}",
          "foreground": "p:terminal-green",
          "background": "",
          "type": "dotnet"
        },
        {
          "style": "plain",
          "template": "\ufcd1 {{ .Full}}",
          "foreground": "p:light-sky-blue",
          "background": "",
          "type": "go"
        },
        {
          "style": "plain",
          "template": "\ue7a8 {{ .Full}}",
          "foreground": "p:terminal-yellow",
          "background": "",
          "type": "rust"
        },
        {
          "properties": {
            "style": "austin",
            "threshold": 350
          },
          "style": "plain",
          "template": " \uf252 {{ .FormattedMs }}",
          "foreground": "p:white-blue",
          "background": "",
          "type": "executiontime"
        },
        {
          "properties": {
            "status_separator": "|",
            "status_template": "{{ if eq .Code 0 }}✔{{ else }}✘ {{.Code}}{{ end }}"
          },
          "style": "plain",
          "foreground": "p:solid-green",
          "background": "",
          "type": "status",
          "foreground_templates": [
            "{{ if ne .Code 0 }}p:terminal-red{{ end }}"
          ]
        }
      ]
    }
  ],
  "tooltips": [
    {
      "properties": {
        "parse_kubeconfig": true
      },
      "style": "plain",
      "template": "\udb84\udcfe  {{ .Context }}",
      "foreground": "p:blue-bell",
      "background": "",
      "type": "kubectl",
      "tips": [
        "k",
        "kubectl",
        "kgp",
        "kdp",
        "kgd",
        "kdd",
        "kgs",
        "kds",
        "kgj",
        "kdj",
        "kgcj",
        "kdcj"
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
